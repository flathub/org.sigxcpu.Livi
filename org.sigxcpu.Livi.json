{
    "app-id" : "org.sigxcpu.Livi",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "48",
    "sdk" : "org.gnome.Sdk",
    "command" : "livi",
    "finish-args" : [
        "--env=GST_PLUGIN_SYSTEM_PATH=/app/lib/gstreamer-1.0:/usr/lib/extensions/codecs-extra/lib/gstreamer-1.0:/usr/lib/x86_64-linux-gnu/gstreamer-1.0",
        "--device=all",
        "--share=ipc",
        "--share=network",
        "--socket=pulseaudio",
        "--socket=wayland",
        "--socket=fallback-x11",
        "--filesystem=xdg-download:ro",
        "--filesystem=xdg-videos:ro"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules" : [
        "shared-modules/gudev/gudev.json",
        {
            "name" : "livi",
            "builddir" : true,
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/guidog/livi",
                    "tag" : "v0.3.2",
                    "commit" : "2db04dbf8d73f8f7ad9b5e15a6f3fc716e402fb3"
                }
            ]
        }
    ]
}
